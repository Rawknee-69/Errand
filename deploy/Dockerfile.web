# syntax=docker/dockerfile:1

FROM oven/bun:1.4.4-slim AS build
WORKDIR /app
COPY package.json bun.lock tsconfig.base.json ./
COPY apps/gateway/package.json apps/gateway/package.json
COPY apps/mock-services/package.json apps/mock-services/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN bun install --frozen-lockfile
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
RUN bun run --cwd apps/web build

FROM oven/bun:1.4.4-slim AS runtime
WORKDIR /srv
ENV NODE_ENV=production WEB_ROOT=/srv/dist WEB_PORT=3000
COPY --from=build /app/apps/web/dist ./dist
COPY apps/web/src/serve.ts ./serve.ts
USER bun
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD ["bun", "-e", "const r = await fetch('http://127.0.0.1:3000/'); if (!r.ok) process.exit(1)"]
CMD ["bun", "run", "/srv/serve.ts"]
