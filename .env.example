# Copy to .env and fill every value with a freshly generated secret.
# The gateway refuses to boot while VAULT_KEY, HMAC_KEY or JWT_SECRET is blank
# or shorter than 32 bytes. Generate each with: openssl rand -base64 32

# Not a secret: the port the gateway listens on.
PORT=8787

VAULT_KEY=
# Comma-separated older key material, kept only while rotating; remove once
# every credential has been re-wrapped.
VAULT_KEY_PREVIOUS=
HMAC_KEY=
JWT_SECRET=

# The single owner's login passphrase. At least 12 characters; never reuse a
# value from this file. Demo mode and the secure-cookie flag are off/on by
# default; turn demo on only for the three-friends demo, which is journaled.
OWNER_PASSPHRASE=
DEMO_MODE=false
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# SQLite database file for the gateway (not a secret); `:memory:` is used by tests.
# Compose overrides DATABASE_PATH, OAUTH_REDIRECT_URI and WEB_ORIGIN with the
# container path and the SITE_ADDRESS-derived URLs; the local values below are
# for running the apps natively.
DATABASE_PATH=errand.db

# Egress guard. `ALLOW_LOCALHOST_DEV=true` lets plain-http localhost through for
# local MCP servers; leave it off anywhere else. Timeout and response cap are in
# milliseconds and bytes. Connector limit is per user.
ALLOW_LOCALHOST_DEV=false
EGRESS_TIMEOUT_MS=15000
EGRESS_MAX_RESPONSE_BYTES=10485760
MAX_CONNECTORS_PER_USER=10

# Forwarding limits. One upstream call, including its connection handshake, is
# bounded by CALL_TIMEOUT_MS; CONNECTOR_CONCURRENCY is the maximum number of
# in-flight calls to any one connector in this gateway process.
CALL_TIMEOUT_MS=15000
CONNECTOR_CONCURRENCY=2

# Exact callback URL registered with OAuth authorization servers. Must match
# the running gateway's public address, including scheme, host, port and path.
OAUTH_REDIRECT_URI=http://127.0.0.1:8787/api/oauth/callback

# Public origin of the web app: scheme, host and port, with no path. When set,
# a browser that finishes an OAuth flow is sent back to /connectors instead of
# a gateway page.
WEB_ORIGIN=http://127.0.0.1:5173

# Compose deployment (see docs/RUNBOOK.md). The public hostname Caddy obtains a
# certificate for: a bare hostname, no scheme. `localhost` uses Caddy's internal
# CA and is only for trying the stack on this machine.
SITE_ADDRESS=localhost
