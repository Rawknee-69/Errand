# Copy to .env and fill every value with a freshly generated secret.
# The gateway refuses to boot while VAULT_KEY, HMAC_KEY or JWT_SECRET is blank
# or shorter than 32 bytes. Generate each with: openssl rand -base64 32

# Not a secret: the port the gateway listens on.
PORT=8787

VAULT_KEY=
HMAC_KEY=
JWT_SECRET=

# SQLite database file for the gateway (not a secret); `:memory:` is used by tests.
DATABASE_PATH=errand.db
